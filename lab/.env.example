# Copier en .env (déjà dans .gitignore) et remplir. Ne jamais commiter .env.
# Alpaca — compte PAPIER uniquement. Le Secret n'est affiché qu'à la génération.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# IBKR : aucun identifiant ici. TWS ou IB Gateway doit tourner en mode papier,
# API activée, port 7497 (TWS) ou 4002 (Gateway).
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
